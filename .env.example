# Copiar a .env y completar localmente. Nunca versionar .env.

SOLARIS_ENV=development

# Rutas del núcleo local
SOLARIS_MODEL_PATH=
SOLARIS_MODEL_BACKEND=local

# API externa opcional (generador no confiable)
SOLARIS_API_PROVIDER=
SOLARIS_API_KEY=
SOLARIS_API_BASE_URL=
SOLARIS_API_MODEL=

# Gobernanza
SOLARIS_KILL_SWITCH_PATH=./data/kill_switch
SOLARIS_REQUIRE_CONSENT=true

# Reproducibilidad
SOLARIS_SEED=42
